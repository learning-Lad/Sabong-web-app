# Public values: needed for real login, database records and private photos.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Private value: read only by the local API/Vercel function. Do not prefix with VITE_.
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Optional, milliseconds (1000..15000). Default is 12000.
# AI_TIMEOUT_MS=12000
